# Defina fora do arquivo, em um gerenciador de segredos ou no ambiente.
# Padrao: production. Use development apenas para desenvolvimento local.
VENDEMAIS_ENV=production
VENDEMAIS_ADMIN_PASSWORD=
# Origem exata do dashboard, incluindo esquema e porta quando necessaria.
VENDEMAIS_ALLOWED_ORIGIN=
# Padrao seguro: true. false apenas em development com origem HTTP de loopback.
VENDEMAIS_COOKIE_SECURE=true
# Airtable read-only API configuration. Use a Personal Access Token with read-records
# access limited to the required base; never commit real credentials.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
